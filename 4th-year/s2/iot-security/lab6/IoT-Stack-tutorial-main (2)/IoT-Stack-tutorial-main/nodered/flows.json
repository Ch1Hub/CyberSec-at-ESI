  {
    "id": "func_format",
    "type": "function",
    "z": "tab_microservices",
    "name": "format val/etat",
    "func": "var sensor = Number(msg.payload);\n\nif (Number.isNaN(sensor)) {\n    return null;\n}\n\nif (sensor >= 25) {\n    msg.payload = {\n        val: sensor,\n        etat: \"high\"\n    };\n} else {\n    msg.payload = {\n        val: sensor,\n        etat: \"low\"\n    };\n}\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 160,
    "wires": [
      [
        "func_to_line_protocol",
        "debug_payload"
      ]
    ]
  },
  {
    "id": "func_to_line_protocol",
    "type": "function",
    "z": "tab_microservices",
    "name": "to Influx line protocol",
    "func": "const p = msg.payload;\nif (!p || typeof p.val !== \"number\") {\n    return null;\n}\nconst etat = String(p.etat || \"\").replace(/\"/g, '\\\\\"');\nmsg.payload = `sensor_temp val=${p.val},etat=\\\"${etat}\\\"`;\nmsg.headers = {\"Content-Type\": \"text/plain\"};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 610,
    "y": 120,
    "wires": [
      [
        "http_write_influx"
      ]
    ]
  },
